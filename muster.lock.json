        "what": "A small Linux telemetry appliance with a serial collector and a separately supervised MQTT bridge.",
        "why": "Serial acquisition and outward broker publication need independent failure and inspection boundaries.",
        "responsibilities": [
          "poll the configured GMC-300 serial device",
          "persist an atomic local measurement snapshot and durable event ledger",
          "publish Home Assistant discovery and state through a bounded MQTT bridge"
        ],
        "failure_modes": [
          {
            "id": "failure-1",
            "summary": "the configured serial device is absent or unreadable"
          },
          {
            "id": "failure-2",
            "summary": "collector state is absent, malformed, or stale"
          },
          {
            "id": "failure-3",
            "summary": "the MQTT publisher is unavailable or the broker cannot be reached"
          }
        ]
